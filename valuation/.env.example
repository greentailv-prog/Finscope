# 复制成 .env 后填写。
#
# 这个文件只被 datasource/ifind.py 与 datasource/choice.py 读取，
# **凭证不会写进代码、不会进日志、不会出现在任何输出里**。
#
# 不填也能跑：会自动回退到 akshare（A股）/ yfinance（美股）。

# ---------- iFinD（同花顺）----------
# 前置：解压 THSDataInterface_Windows_*.zip → 运行 bin/Tool/SuperCommand.exe
#      登录 → 把 bin/x64/iFinDPy.py 复制到 site-packages
IFIND_USER=
IFIND_PASSWORD=

# ---------- Choice（东方财富）----------
# 前置：解压 EMQuantAPI_Python.zip → 运行 EmQuantAPISetup.exe 安装
#      并把 python3/EmQuantAPI.py 复制到 site-packages
CHOICE_USER=
CHOICE_PASSWORD=

# ---------- 可选：指定取数用的 Python 解释器 ----------
# 留空时自动探测（iFinD 自带运行时 > py 启动器 > 当前解释器）
# FINSCOPE_DATA_PYTHON=C:\path\to\python.exe
