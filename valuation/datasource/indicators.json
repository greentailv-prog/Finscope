  "_已验证指标": {},

  "api": {
    "基础数据": "THS_BasicData(thsCode, indicatorName, paramOption)",
    "日期序列": "THS_DateSerial(thscode, jsonIndicator, jsonparam, globalparam, begintime, endtime)",
    "板块成分": "THS_DataPool('block', '日期;板块ID', 'date:Y,thscode:Y,security_name:Y')",
    "宏观EDB": "THS_EDB(indicators, param, begintime, endtime)",
    "自然语言": "THS_iwencai(query, domain)",
    "转DataFrame": "THS_Trans2DataFrame(data)"
  }
