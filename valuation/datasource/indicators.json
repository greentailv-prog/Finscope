    "revenue": ["ths_operating_total_revenue_stock", "ths_revenue_stock", "ths_operating_revenue_stock"],
    "cogs": ["ths_operating_cost_stock", "ths_cost_of_sales_stock"],
    "ebit": ["ths_operating_profit_stock"],
    "pretax_income": ["ths_total_profit_stock"],
    "tax_provision": ["ths_income_tax_expense_stock"],
    "net_income": ["ths_np_stock", "ths_net_profit_stock"],
    "net_income_parent": ["ths_np_atoopc_stock"],
    "interest_expense": ["ths_interest_expense_stock", "ths_financial_expense_stock"],
    "da": ["ths_depreciation_amortization_stock", "ths_fa_co_stock"],
    "capex": ["ths_cash_paid_fixed_assets_stock", "ths_capex_stock"],
    "total_assets": ["ths_total_assets_stock"],
    "total_liab": ["ths_total_liab_stock"],
    "total_equity": ["ths_total_equity_stock", "ths_total_shareholder_equity_stock"],
    "cash": ["ths_cash_stock", "ths_monetary_fund_stock"],
    "short_debt": ["ths_short_loan_stock"],
    "long_debt": ["ths_long_loan_stock"],
    "shares": ["ths_total_shares_stock"],
    "pe": ["ths_pe_stock"],
    "pb": ["ths_pb_stock"],
    "ps": ["ths_ps_stock"],
    "price": ["ths_close_price_stock", "ths_latest_price_stock"],
